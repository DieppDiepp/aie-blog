# Copy this file to .env.prod ON THE VPS and fill in real values.
# The real .env.prod is git-ignored and never leaves the VPS.

# PostgreSQL: use a strong password in production, not the dev default.
POSTGRES_USER=aie
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_DB=aie_blog

# Backend. Must match the POSTGRES_* values above (host is the compose service "db").
DATABASE_URL=postgresql+psycopg://aie:CHANGE_ME_STRONG@db:5432/aie_blog
# The public origin the site is served from, for CORS. With a quick tunnel the
# URL is random and only matters if the browser calls the api directly (it does
# not yet, the site is static), so a placeholder is fine for now.
FRONTEND_ORIGIN=https://placeholder.trycloudflare.com

# Frontend: internal address of the api inside the docker network.
API_URL=http://api:8000

# Which image tag to run. The deploy step overrides this with the git SHA;
# leave as latest for a manual "run whatever is newest" pull.
IMAGE_TAG=latest

# Note: the quick tunnel needs no token. cloudflared gets its random
# *.trycloudflare.com URL at runtime; read it from `docker compose logs cloudflared`.
