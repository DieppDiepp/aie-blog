# Copy this file to .env and adjust values. Never commit the real .env.

# PostgreSQL
POSTGRES_USER=aie
POSTGRES_PASSWORD=aie
POSTGRES_DB=aie_blog

# Backend
DATABASE_URL=postgresql+psycopg://aie:aie@db:5432/aie_blog
FRONTEND_ORIGIN=http://localhost:3000

# Frontend
# URL the frontend server uses to reach the API inside the docker network.
API_URL=http://api:8000
